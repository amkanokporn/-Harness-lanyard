rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /signatures/{signatureId} {
      allow read: if true;
      allow write: if isValidSignature(request.resource.data);
      allow delete: if true;
    }
  }

  function isValidSignature(data) {
    return data.name is string && data.name.size() <= 255
      && data.signatureDataUrl is string;
  }
}
