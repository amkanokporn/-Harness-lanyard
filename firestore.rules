rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /signatures {
      allow list: if true;
    }
    match /signatures/{signatureId} {
      // Allow public read access to signatures to fix the 'Missing or insufficient permissions' error
      allow read: if true;
      allow create, update: if request.auth != null && isValidSignature(request.resource.data);
      allow delete: if request.auth != null;
    }
  }

  function isValidSignature(data) {
    return data.name is string && data.name.size() <= 255
      && data.signatureDataUrl is string
      && data.uploadedAt is string;
  }
}
